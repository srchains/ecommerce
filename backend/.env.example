# ==========================================
# SR Chains Backend Environment Variables Example
# Copy this file to .env and adjust values for your environment.
# ==========================================

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8000

# Database Configuration
# Local SQLite: sqlite:///./sr_chains.db
# Supabase PostgreSQL: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./sr_chains.db

# Authentication Secrets & Tokenized Admin Credentials
AUTH_SECRET_SEED=SR_CHAINS_SECRET_KEY_FOR_TOKEN_DECRYPTION_1957
ADMIN_EMAIL=srchains19@gmail.com
# Tokenized PBKDF2 Password Hash (Recommended for security)
ADMIN_PASSWORD_HASH=7c1f1da6fb6d4eee1b92d6962f74e21463a3501645cf0a29ff70cc3f5370139d

# Business & Communication Settings
WHOLESALER_PHONE=917010674487
LIVE_PRICE_POLL_INTERVAL=15

# ─── Email OTP (staff login + customer signup) ──────────────────────────────
# Master switch. false = email + password only (no code). Set true once SMTP works.
AUTH_OTP_ENABLED=false
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_SESSION_TTL_HOURS=24
# Local dev only: set true to echo the OTP in API responses. Keep false in prod.
AUTH_OTP_DEV_RETURN=false

# ─── SMTP (Gmail app password) ──────────────────────────────────────────────
# Create at: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=srchains19@gmail.com
SMTP_PASSWORD=
SMTP_FROM=srchains19@gmail.com
SMTP_FROM_NAME=SR Chains
